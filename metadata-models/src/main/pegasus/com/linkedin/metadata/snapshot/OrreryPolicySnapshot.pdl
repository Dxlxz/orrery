namespace com.linkedin.metadata.snapshot

import com.linkedin.common.Urn
import com.linkedin.metadata.aspect.OrreryPolicyAspect

/**
 * A metadata snapshot for Orrery Access Policy data.
 */
@Entity = {
  "name": "orreryPolicy",
  "keyAspect": "orreryPolicyKey"
}
record OrreryPolicySnapshot {

  /**
   * URN for the entity the metadata snapshot is associated with.
   */
  urn: Urn

  /**
   * The list of metadata aspects associated with the Orrery access policy.
   */
  aspects: array[OrreryPolicyAspect]
}