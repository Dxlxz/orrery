namespace com.linkedin.upgrade

/**
 * Information collected when kicking off a OrreryUpgrade
 */
@Aspect = {
   "name": "orreryUpgradeRequest"
}
record OrreryUpgradeRequest {

    /**
     * Timestamp when we started this OrreryUpgrade
     */
    timestampMs: long

    /**
     * Version of this upgrade
     */
    version: string
}